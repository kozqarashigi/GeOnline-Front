# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017/geoonline
JWT_SECRET=change-me-in-production
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Optional: seed admin (npm run seed:admin)
# ADMIN_PHONE=+77000000000
# ADMIN_PASSWORD=

# Optional: SMTP for registration codes
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# REG_MAIL_SUBJECT=GeoOnline: код подтверждения

# Optional
# PUBLIC_ORIGIN=http://localhost:3000
